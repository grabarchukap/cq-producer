# Telegram
TELEGRAM_BOT_TOKEN=

# AI APIs
ANTHROPIC_API_KEY=

# Admin panel — pick a long random password, /admin is open to anyone who knows it
ADMIN_PASSWORD=

# Set to "true" for local development (uses polling instead of webhook)
DEV_MODE=true

# Webhook — public URL without trailing slash (e.g. https://yourapp.railway.app)
# Required only when DEV_MODE=false
WEBHOOK_URL=https://yourapp.example.com
# Port the server listens on (8443 is Telegram-allowed; use 8080 behind a proxy)
WEBHOOK_PORT=8443
# Optional but recommended — random string for webhook request validation
WEBHOOK_SECRET_TOKEN=your_random_webhook_secret_here
# docker-compose only: name of the Docker network shared with the cloudflared
# container (not read by the bot itself)
TUNNEL_NETWORK=tgbots

# Optional — override default Claude model
# CLAUDE_MODEL=claude-sonnet-4-6

# Groq speech-to-text for voice messages (key: https://console.groq.com/keys)
# Without a key the bot accepts text only
GROQ_API_KEY=
# whisper-large-v3 (best for Russian) or whisper-large-v3-turbo (faster)
# GROQ_STT_MODEL=whisper-large-v3

# Google Docs export (for case interview results)
# OAuth2 credentials file downloaded from Google Cloud Console — needed only by
# auth_google.py, not by the running bot
GOOGLE_CREDENTIALS_FILE=credentials.json
# Token file created by running auth_google.py (do not commit).
# Defaults to DATA_DIR/token.json when DATA_DIR is set.
GOOGLE_TOKEN_FILE=
# Google Drive folder ID where case documents will be created
# Get it from the folder URL: drive.google.com/drive/folders/THIS_PART
GOOGLE_DRIVE_FOLDER_ID=
