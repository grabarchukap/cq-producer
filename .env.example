# Telegram
TELEGRAM_BOT_TOKEN=

# AI APIs
ANTHROPIC_API_KEY=
OPENAI_API_KEY=your_openai_api_key_here

# Admin panel
ADMIN_PASSWORD=1123

# Set to "true" for local development (uses polling instead of webhook)
DEV_MODE=true

# Webhook — public URL without trailing slash (e.g. https://yourapp.railway.app)
# Required only when DEV_MODE=false
WEBHOOK_URL=https://yourapp.example.com
# Port the server listens on (8443 is Telegram-allowed; use 8080 behind a proxy)
WEBHOOK_PORT=8443
# Optional but recommended — random string for webhook request validation
WEBHOOK_SECRET_TOKEN=your_random_webhook_secret_here

# Optional — override default Claude model
# CLAUDE_MODEL=claude-sonnet-4-6
